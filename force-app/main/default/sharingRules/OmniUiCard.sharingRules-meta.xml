        <label>Omni UI Guest Sharing Rule</label>
        <sharedTo>
            <guestUser>Provider_Portal</guestUser>
        </sharedTo>
        <criteriaItems>
            <field>IsActive</field>
            <operation>equals</operation>
            <value>True</value>
        </criteriaItems>
        <includeHVUOwnedRecords>false</includeHVUOwnedRecords>
    </sharingGuestRules>
</SharingRules>
