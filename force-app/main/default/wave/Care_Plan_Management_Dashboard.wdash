ember.Id\"]).asEquality(\"CarePlanMember.Id\")}};\n{{cell(lens_1_1.result, 0, \"Holder2\").asString()}}q = filter q by {{column(Members_by_High_Prio_2.result, [\"CarePlanMember.Id\"]).asEquality(\"CarePlanMember.Id\")}};\nq_hightask = filter q by 'Task.Priority' == \"High\";\nq_Taskcompleted = filter q by 'Task.Status' in [\"Completed\"];\n\nq = group q by ('CarePlanMember.Id','CarePlanMember.Name') full, q_hightask by ('CarePlanMember.Id','CarePlanMember.Name') full, q_Taskcompleted by ('CarePlanMember.Id','CarePlanMember.Name');\n\n\nq = foreach q generate first(q.'CarePlanMember.AccountNumber') as 'CarePlanMember.AccountNumber'\n, q.'CarePlanMember.Name' as 'CarePlanMember.Name'\n, unique(q.'Id') as 'Care Plans'\n, unique(q.'Task.Id') as 'Total Tasks'\n, coalesce(unique(q_hightask.'Task.Id'),0) as 'High Priority Tasks'\n, (coalesce(unique(q_Taskcompleted.'Task.Id'),0) / unique(q.'Task.Id')) as 'CarePlan Progress'\n, first(q.'CarePlan_Status') as 'CarePlan_Status';\nq = order q by ('CarePlanMember.AccountNumber' asc);\nq = limit q 2000;","receiveFacetSource":{"mode":"exclude","steps":["CarePlanMembers_by_N_2","Members_by_Number_of_1","Members_by_High_Prio_1","Members_by_High_Prio_2","CarePlan_by_Progress_1"]},"selectMode":"single","strings":[],"type":"saql","useExternalFilters":false,"useGlobal":true,"visualizationParameters":{"parameters":{"borderColor":"#FFFFFF","borderWidth":1,"cell":{"backgroundColor":"#ffffff","fontColor":"#16325c","fontSize":12,"textWrap":true},"columnProperties":{"CarePlan_Progress":{"parameters":{},"type":"bar"}},"columns":[],"customBulkActions":[],"header":{"backgroundColor":"#f4f6f9","fontColor":"#16325c","fontSize":12,"textWrap":true},"headerProperties":{},"innerMajorBorderColor":"#E6ECF2","innerMinorBorderColor":"#E6ECF2","interactions":[],"mode":"fittocontainer","numberOfLines":1,"showActionMenu":true,"showRowIndexColumn":false,"totals":true,"verticalPadding":8},"type":"table"}},"lens_1_1":{"broadcastFacet":true,"groups":[],"label":"H