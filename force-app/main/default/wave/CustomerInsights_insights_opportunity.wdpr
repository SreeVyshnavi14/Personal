    "FORMULA9" : {
      "action" : "formula",
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "defaultValue" : "",
          "formulaExpression" : "case \n    when LastActivityDate is null\n        then datediff(LastModifiedDate, now())\n    when LastModifiedDate > LastActivityDate\n        then datediff(LastModifiedDate, now())\n    else \n        datediff(LastActivityDate, now())\nend",
          "label" : "DaysSinceLastActivity",
          "name" : "DaysSinceLastActivity",
          "precision" : 18,
          "scale" : 0,
          "type" : "NUMBER"
        } ]
      },
