    "FORMULA8" : {
      "action" : "formula",
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "defaultValue" : "",
          "formulaExpression" : "case when DaysSinceLastActivity >= 60 and IsClosed = false then 'true' else 'false' end",
          "label" : "Neglected",
          "name" : "Neglected",
          "precision" : 255,
          "type" : "TEXT"
