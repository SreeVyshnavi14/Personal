\",\"saqlExpression\":\"case when 'CareBarrier.PatientId' is not null then 'CareBarrier.PatientId' else 'PatientId' end \",\"type\":\"Text\"},{\"label\":\"Compute_CareDeterminantId\",\"name\":\"Compute_CareDeterminantId\",\"precision\":1,\"saqlExpression\":\"case when 'Id' == 'AppendCareBarriers.CareDeterminantId' then 1 else 0 end\",\"scale\":0,\"type\":\"Numeric\"},{\"defaultValue\":\"Not Defined\",\"label\":\"CareDeterminantIds\",\"name\":\"CareDeterminantIds\",\"saqlExpression\":\"case when 'CareDeterminant.Id' is not null then 'CareDeterminant.Id' else 'CareDeterminantId1'  end\",\"type\":\"Text\"},{\"defaultValue\":\"Not Defined\",\"label\":\"CareDeterminantNames\",\"name\":\"CareDeterminantNames\",\"saqlExpression\":\"case when 'CareDeterminant.Name' is null then 'CareDeterminantType.Name' else 'CareDeterminant.Name' end\",\"type\":\"Text\"},{\"defaultValue\":\"Not Defined\",\"label\":\"CareBarrierPriority\",\"name\":\"CareBarrierPriority\",\"saqlExpression\":\"case when 'CareBarrier.Priority' is not null then 'CareBarrier.Priority' else 'Priority' end\",\"type\":\"Text\"},{\"defaultValue\":\"Not Defined\",\"label\":\"CareDeterminantType\",\"name\":\"CareDeterminantType\",\"saqlExpression\":\"case when 'CareDeterminant.CareDeterminantType.Type' is not null then 'CareDeterminant.CareDeterminantType.Type' else 'CareDeterminantType.Type' end\",\"type\":\"Text\"},{\"defaultValue\":\"Not Defined\",\"label\":\"CareDeterminantTypeIds\",\"name\":\"CareDeterminantTypeIds\",\"saqlExpression\":\"case when 'CareDeterminant.CareDeterminantTypeId' is not null then 'CareDeterminant.CareDeterminantTypeId' else 'CareDeterminantTypeId' end\",\"type\":\"Text\"},{\"defaultValue\":\"Not Defined\",\"label\":\"CareBarrierStatus\",\"name\":\"CareBarrierStatus\",\"saqlExpression\":\"case when 'CareBarrier.Status' is null then 'Status' else 'CareBarrier.Status' end\",\"type\":\"Text\"},{\"label\":\"Barrier_Created_Days\",\"name\":\"Barrier_Created_Days\",\"precision\":16,\"saqlExpression\":\"case when 'CareBarrier.BarrierCreatedDay' is null then 'BarrierCreatedDay' else 'CareBarrier.BarrierCreatedDay' end\",\"scale\":0,\"type\":\"Numeric\"},{\"label\":\"BarrierCreatedDays\",\"name\":\"BarrierCreatedDays\",\"saqlExpression\":\"case when Barrier_Created_Days  >= 0 && Barrier_Created_Days <= 7 then \\\"1.0-7 days\\\" when Barrier_Created_Days > 7 && Barrier_Created_Days <= 14 then \\\"2.8-14 days\\\"  when Barrier_Created_Days > 14 && Barrier_Created_Days <= 30 then \\\"3.15-30 days\\\" when Barrier_Created_Days > 30 then \\\"4.30+ days\\\" end\",\"type\":\"Text\"}],\"mergeWithSource\":true},\"sources\":[\"HLS_Append_CareBarriers_With_CareDeterminants\"]},\"HLS_Digest_Visitor\":{\"action\":\"sobjectDigest\",\"parameters\":{\"fields\":[{\"name\":\"AssigneeId\"},{\"name\":\"Id\"},{\"name\":\"Name\"},{\"name\":\"VisitId\"},{\"name\":\"IsPrimaryResource\"}],\"object\":\"Visitor\",\"passthroughFilter\":\"IsPrimaryResource = true\"}},\"HLS_Digest_ProgramPatientAffiliation\":{\"action\":\"sobjectDigest\",\"parameters\":{\"fields\":[{\"name\":\"HealthCloudGA__Account__c\"},{\"name\":\"HealthCloudGA__Program__c\"},{\"name\":\"Id\"}],\"object\":\"HealthCloudGA__ProgramPatientAffiliation__c\"}},\"HLS_Digest_AssessmentTask\":{\"action\":\"sobjectDigest\",\"parameters\":{\"fields\":[{\"name\":\"AssessmentTaskDefinitionId\"},{\"name\":\"Id\"},{\"name\":\"IsRequired\"},{\"name\":\"Name\"},{\"name\":\"OwnerId\"},{\"name\":\"ParentId\"},{\"name\":\"Status\"},{\"name\":\"TaskType\"}],\"object\":\"AssessmentTask\"}},\"HLS_Augment_User_onto_Goal\":{\"action\":\"augment\",\"parameters\":{\"leftKey\":[\"Goal.OwnerId\"],\"operation\":\"LookupSingleValue\",\"relationship\":\"Owner\",\"rightKey\":[\"Id\"],\"rightSelect\":[\"Email\",\"Id\",\"IsActive\",\"ManagerId\",\"isDuplicate\",\"Name\",\"Role.DeveloperName\",\"Role.Hierarchy_RoleNames\",\"Role.Name\",\"Role.ParentRole.DeveloperName\",\"Role.ParentRole.Name\",\"State\",\"UniqueUserName\",\"Username\",\"UserType\",\"ContactId\",\"AccountId\",\"FirstName\",\"Role.Id\",\"Role.ParentRoleId\",\"Role.PortalAccountId\",\"Role.PortalAccountOwnerId\",\"Role.ParentRole.ParentRoleId\",\"Role.Hierarchy_RoleNamesPath\",\"MediumBannerPhotoUrl\",\"MediumPhotoUrl\"]},\"sources\":[\"HLS_Augment_CareplanTemplate_Onto_Tasks\",\"HLS_Compute_Manager_Unique\"]},\"HLS_Digest_UserRole\":{\"action\":\"sobjectDigest\",\"parameters\":{\"fields\":[{\"name\":\"Id\"},{\"name\":\"Name\"},{\"name\":\"ParentRoleId\"},{\"name\":\"PortalAccountId\"},{\"name\":\"PortalAccountOwnerId\"},{\"name\":\"DeveloperName\"}],\"object\":\"UserRole\"}},\"HLS_Augment_Product_Onto_OrderItem\":{\"action\":\"augment\",\"parameters\":{\"leftKey\":[\"Product2Id\"],\"operation\":\"LookupSingleValue\",\"relationship\":\"Product\",\"rightKey\":[\"Id\"],\"rightSelect\":[\"Description\",\"Family\",\"Id\",\"Name\",\"PriceBookEntry.Id\",\"PriceBookEntry.Name\",\"PriceBookEntry.PriceBook.Id\",\"PriceBookEntry.PriceBook.IsStandard\",\"PriceBookEntry.PriceBook.Name\",\"PriceBookEntry.Pricebook2Id\",\"PriceBookEntry.Product2Id\",\"PriceBookEntry.ProductCode\",\"PriceBookEntry.UnitPrice\",\"PriceBookEntry.UseStandardPrice\",\"ProductCode\",\"Products.Id\",\"Products.LocationId\",\"Products.Product2Id\",\"Products.ProductItemNumber\",\"Products.ProductName\",\"Products.QuantityOnHand\",\"Products.QuantityUnitOfMeasure\",\"QuantityUnitOfMeasure\",\"SystemModstamp\"]},\"sources\":[\"HLS_Augment_Order_Onto_OrderItem\",\"HLS_Augment_PriceBook_Onto_Products\"]},\"HLS_CE_Products\":{\"action\":\"computeExpression\",\"parameters\":{\"computedFields\":[{\"label\":\"OrderAgeDays\",\"name\":\"OrderAgeDays\",\"saqlExpression\":\"case when 'Order.Status' == \\\"Completed\\\" then  daysBetween(toDate('Order.EffectiveDate_sec_epoch'),toDate('Order.EndDate_sec_epoch')) end\",\"scale\":0,\"type\":\"Numeric\"},{\"defaultValue\":\"0\",\"label\":\"Revenue\",\"name\":\"Revenue\",\"precision\":12,\"saqlExpression\":\"('Quantity')*('UnitPrice')\",\"scale\":0,\"type\":