          "name" : "Member_Status",
          "label" : "Member Status",
          "formulaExpression" : "first_value(CarePlan_Status)",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA34" : {
      "action" : "formula",
      "sources" : [ "FORMULA33" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "NUMBER",
          "name" : "CarePlan_Progress",
          "label" : "CarePlan Progress",
          "formulaExpression" : "case \n    when \"Task.Status\" = 'Delayed' then 1\n    when \"Task.Status\" = 'Not Started' then 2\n    when \"Task.Status\" = 'Waiting on someone else' then 3\n    when \"Task.Status\" = 'In Progress' then 4\n    when \"Task.Status\" = 'Completed' then 5\nend",
          "precision" : 10,
          "scale" : 0,
          "defaultValue" : ""
        } ]
      }
    },
