    "FORMULA31" : {
      "action" : "formula",
      "sources" : [ "APPEND6" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Task_Status_Modified",
          "label" : "Task Status Modified",
          "formulaExpression" : "case \n    when \"Task.Status\" = 'Delayed' then '1- Delayed'\n    when \"Task.Status\" = 'Not Started' then '2- Not Started'\n    when \"Task.Status\" = 'Waiting on someone else' then '3- Waiting on someone else'\n    when \"Task.Status\" = 'In Progress' then '4- In Progress'\n    when \"Task.Status\" = 'Completed' then '5- Completed'\n    else \"Task.Status\"\n\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA32" : {
      "action" : "computeRelative",
      "sources" : [ "FORMULA31" ],
      "parameters" : {
        "partitionBy" : [ "Id" ],
        "orderBy" : [ {
          "fieldName" : "Task_Status_Modified",
          "direction" : "ASC"
        } ],
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "CarePlan_Status",
          "label" : "CarePlan Status",
          "formulaExpression" : "first_value(Task_Status_Modified)",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
    "FORMULA33" : {
      "action" : "computeRelative",
      "sources" : [ "FORMULA32" ],
      "parameters" : {
