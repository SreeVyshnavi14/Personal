    "FORMULA25" : {
      "action" : "formula",
      "sources" : [ "FORMULA24" ],
      "parameters" : {
        "expressionType" : "SQL",
        "fields" : [ {
          "type" : "TEXT",
          "name" : "Created_Date_Month",
          "label" : "Created Date Month",
          "formulaExpression" : "case\nwhen month(CreatedDate) = 01 then 'Jan'\nwhen month(CreatedDate) = 02 then 'Feb'\nwhen month(CreatedDate) = 03 then 'Mar'\nwhen month(CreatedDate) = 04 then 'Apr'\nwhen month(CreatedDate) = 05 then 'May'\nwhen month(CreatedDate) = 06 then 'June'\nwhen month(CreatedDate) = 07 then 'July'\nwhen month(CreatedDate) = 08 then 'Aug'\nwhen month(CreatedDate) = 09 then 'Sep'\nwhen month(CreatedDate) = 10 then 'Oct'\nwhen month(CreatedDate) = 11 then 'Nov'\nwhen month(CreatedDate) = 12 then 'Dec'\nend",
          "precision" : 255,
          "defaultValue" : ""
        } ]
      }
    },
