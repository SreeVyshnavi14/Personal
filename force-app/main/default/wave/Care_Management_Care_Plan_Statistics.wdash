{"dataSourceLinksInfo":{"enableAutomaticLinking":true,"excludeRelationships":[],"links":[]},"filters":[],"gridLayouts":[{"maxWidth":700,"name":"Default","numColumns":50,"pages":[{"label":"Care Plan Statistics","name":"7b5dddb4-0bd9-4685-b3b8-9d3863b3e4c6","navigationHidden":false,"widgets":[{"colspan":50,"column":0,"name":"container_1","row":0,"rowspan":35,"widgetStyle":{"backgroundColor":"#FFFFFF","borderColor":"#C6D3E1","borderEdges":[],"borderRadius":8,"borderWidth":2}},{"colspan":4,"column":1,"name":"image_1","row":1,"rowspan":4,"widgetStyle":{"borderEdges":[]}},{"colspan":31,"column":5,"name":"text_1","row":1,"rowspan":4,"widgetStyle":{"borderEdges":[]}},{"colspan":50,"column":0,"name":"text_2","row":5,"rowspan":1,"widgetStyle":{"backgroundColor":"#FFFFFF","borderColor":"#E6ECF2","borderEdges":["bottom"],"borderRadius":0,"borderWidth":2}},{"colspan":50,"column":0,"name":"chart_1","row":6,"rowspan":29,"widgetStyle":{"borderEdges":[]}}]}],"rowHeight":"fine","selectors":[],"style":{"alignmentX":"left","alignmentY":"top","backgroundColor":"#FFFFFF","cellSpacingX":0,"cellSpacingY":0,"fit":"original","gutterColor":"#C5D3E0"},"version":1.0}],"layouts":[],"steps":{"AvgCarePlans_1":{"broadcastFacet":true,"groups":[],"label":"Care Plans Created","numbers":[],"query":"q = load \"Care_Management\";\nq = filter q by date('CreatedDate_Year', 'CreatedDate_Month', 'CreatedDate_Day') in [\"12 months ago\"..\"current day\"];\nq_A = filter q by 'Status' in [\"Completed\"];\nq_B = filter q by 'Status' not in [\"Completed\"];\nq = cogroup q_B by ('CreatedDate_Year', 'CreatedDate_Month') full, q_A by ('CreatedDate_Year', 'CreatedDate_Month');\nq = foreach q generate coalesce(q_B.'CreatedDate_Year', q_A.'CreatedDate_Year') as 'CreatedDate_Year', coalesce(q_B.'CreatedDate_Month', q_A.'CreatedDate_Month') as 'CreatedDate_Month', coalesce(unique(q_A.'Id'),0) as 'Care Plans Completed', coalesce(unique(q_B.'Id'),0) as 'Care Plans Not Completed';\nq = order q by ('CreatedDate_Year' asc, 'C