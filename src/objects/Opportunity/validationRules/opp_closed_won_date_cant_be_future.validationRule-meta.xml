<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>opp_closed_won_date_cant_be_future</fullName>
    <active>false</active>
    <errorConditionFormula>AND(ISPICKVAL( StageName , &quot;Closed Won&quot;), CloseDate &gt; TODAY() )</errorConditionFormula>
    <errorMessage>Here Opportunity is closed won. So date should not be in future</errorMessage>
</ValidationRule>
