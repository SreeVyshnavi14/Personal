<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>billing_province_must_have_value</fullName>
    <active>true</active>
    <errorConditionFormula>AND( ISBLANK(BillingState), OR(BillingCountry = &quot;United States&quot;,BillingCountry = &quot;Canada&quot;))</errorConditionFormula>
    <errorMessage>Account records must have a Billing
State/Province value if the Billing Country is  United States or
Canada.</errorMessage>
</ValidationRule>
